# Solana RPC (a keyed Helius endpoint is recommended; the public one rate-limits)
SOLANA_RPC=https://api.mainnet-beta.solana.com
PORT=5560
# The site's public origin: token metadata is HOSTED HERE (https://<domain>/meta/<hash>.json) and must stay up forever
PUBLIC_URL=https://example.com
# Pinata v3 Files API JWT (optional): a durable IPFS backup of every coin's image + metadata JSON
PINATA_JWT=
# Where the grinder drops `<address>.json` keypairs ending in `ipo` (optional; without a pool, mints are plain addresses)
VANITY_INCOMING=./data/vanity-incoming
# Refuse launches when no address is in stock (1, the default). 0 is for tests only: it hands out plain addresses
VANITY_REQUIRED=1
LAUNCH_PRIORITY_MICROLAMPORTS=200000
TRADE_PRIORITY_MICROLAMPORTS=100000
# The launch lookup table (scripts/make-lut.mjs records it in the database; set here only to override)
LOOKUP_TABLE=

# ── launches (hooked Meteora curve → pump.fun when it fills at the creator's cap) ──
# The hook program. Required on the box: deploy.sh does not copy hk/keys there
HOOK_PROGRAM=D7JBFRvengCEwz6d3xNVZzFCwrFwvwWa4DbF4DkQjPmV
# The hot wallet file (made on first start; FUND IT with ~0.5 SOL: configs + lookup table ~0.06 SOL once, then a fee float)
PLATFORM_KEY=./data/platform.json
# Where the hot wallet's surplus is swept (never the hot wallet itself); empty = no sweep
TREASURY=
# Graduator pacing on a keyed RPC
RPC_RPS=3
# 1 = every launch is a window launch (no plain pump.fun launches while window launches are not ready)
WINDOW_ONLY=1
